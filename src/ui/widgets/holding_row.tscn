[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/widgets/holding_row.gd" id="1_row"]

[node name="HoldingRow" type="PanelContainer"]
theme_type_variation = &"Card"
script = ExtResource("1_row")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Name" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
size_flags_horizontal = 3
text = "Stalk"
clip_text = true

[node name="Shares" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(56, 0)
layout_mode = 2
theme_type_variation = &"Numeric"
text = "0"
horizontal_alignment = 2

[node name="Price" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(76, 0)
layout_mode = 2
theme_type_variation = &"Muted"
text = "$100"
horizontal_alignment = 2

[node name="Value" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
theme_type_variation = &"Numeric"
text = "$0"
horizontal_alignment = 2

[node name="Amount" type="LineEdit" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(78, 0)
layout_mode = 2
placeholder_text = "max 0"
alignment = 2

[node name="SellButton" type="Button" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(62, 0)
layout_mode = 2
text = "Sell"

[node name="SellAllButton" type="Button" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 0)
layout_mode = 2
text = "All"
tooltip_text = "Sell every share you hold of this stalk"
