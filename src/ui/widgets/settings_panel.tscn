[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/widgets/settings_panel.gd" id="1_settings"]

[node name="SettingsPanel" type="VBoxContainer"]
theme_type_variation = &"TightVBox"
script = ExtResource("1_settings")

[node name="VolumeRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="VolumeLabel" type="Label" parent="VolumeRow"]
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
text = "Sound"

[node name="VolumeSlider" type="HSlider" parent="VolumeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 100.0
step = 5.0
value = 100.0

[node name="VolumeValue" type="Label" parent="VolumeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 0)
layout_mode = 2
theme_type_variation = &"Numeric"
text = "100%"
horizontal_alignment = 2

[node name="ResolutionRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="ResolutionLabel" type="Label" parent="ResolutionRow"]
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
text = "Resolution"

[node name="ResolutionOption" type="OptionButton" parent="ResolutionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
size_flags_horizontal = 3

[node name="FullscreenRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="FullscreenLabel" type="Label" parent="FullscreenRow"]
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
text = "Fullscreen"

[node name="FullscreenCheck" type="CheckBox" parent="FullscreenRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Fill the screen"

[node name="SettingsNote" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"Faint"
text = "Kept between sessions. Resolution applies in a window; fullscreen uses the whole screen."
autowrap_mode = 3
