[ext_resource type="PackedScene" path="res://src/ui/widgets/trade_box.tscn" id="4_trade"]

[node name="CompanyTab" type="ScrollContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
script = ExtResource("1_tab")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TightVBox"

[node name="Title" type="HBoxContainer" parent="Body"]
layout_mode = 2

[node name="PreviousButton" type="Button" parent="Body/Title"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
tooltip_text = "The row above on the board"
text = "<"

[node name="CompanyName" type="Label" parent="Body/Title"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
theme_type_variation = &"SubHeading"
text = ""
clip_text = true
text_overrun_behavior = 3

[node name="NextButton" type="Button" parent="Body/Title"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
tooltip_text = "The row below on the board"
text = ">"

[node name="IdentityLine" type="HBoxContainer" parent="Body"]
layout_mode = 2

