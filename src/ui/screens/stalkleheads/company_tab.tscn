[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://src/ui/screens/stalkleheads/company_tab.gd" id="1_tab"]
[ext_resource type="PackedScene" path="res://src/ui/widgets/cell_row.tscn" id="2_row"]
[ext_resource type="PackedScene" path="res://src/ui/widgets/ledger_widget.tscn" id="3_ledger"]
[ext_resource type="PackedScene" path="res://src/ui/widgets/trade_box.tscn" id="4_trade"]
[ext_resource type="PackedScene" path="res://src/ui/widgets/drawn_chart.tscn" id="5_chart"]

[node name="CompanyTab" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"TightVBox"
script = ExtResource("1_tab")

[node name="Title" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TightVBox"

[node name="PickButton" type="Button" parent="Title"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
focus_mode = 0
tooltip_text = "Every company, to pick one"
text = "COMPANIES"

[node name="PreviousButton" type="Button" parent="Title"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
tooltip_text = "The previous company"
text = "<"

[node name="CompanyName" type="Label" parent="Title"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
theme_type_variation = &"SubHeading"
text = ""
clip_text = true
text_overrun_behavior = 3

[node name="NextButton" type="Button" parent="Title"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
tooltip_text = "The next company"
text = ">"

[node name="IdentityLine" type="HBoxContainer" parent="Scroll/Body"]
layout_mode = 2

[node name="Identity" parent="Scroll/Body/IdentityLine" instance=ExtResource("2_row")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="HeldLabel" type="Label" parent="Scroll/Body/IdentityLine"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Faint"
text = ""

[node name="Trade" parent="Scroll/Body/IdentityLine" instance=ExtResource("4_trade")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4

[node name="Description" type="Label" parent="Scroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"EventFlavour"
text = ""
autowrap_mode = 3

[node name="Middle" type="HBoxContainer" parent="Scroll/Body"]
layout_mode = 2

[node name="EarningsArea" type="VBoxContainer" parent="Scroll/Body/Middle"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TightVBox"

[node name="Views" type="HBoxContainer" parent="Scroll/Body/Middle/EarningsArea"]
unique_name_in_owner = true
layout_mode = 2

[node name="Earnings" type="VBoxContainer" parent="Scroll/Body/Middle/EarningsArea"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TightVBox"

[node name="CompanyChart" parent="Scroll/Body/Middle/EarningsArea" instance=ExtResource("5_chart")]
