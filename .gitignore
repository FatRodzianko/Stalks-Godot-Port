/build/
/builds/
/export/
*.pck
*.exe
*.zip
*.dmg
*.apk
*.aab

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
.directory
*~
*.swp
.vscode/
.idea/

# ---- Logs ----
*.log
logs/
