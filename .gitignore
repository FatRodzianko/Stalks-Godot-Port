# ---- Godot 4 ----
# Generated import cache and editor state. Never commit.
.godot/
/android/

# Legacy Godot 3 import folder, here only as a safety net.
.import/

# Export configuration can contain local paths and signing credentials.
export.cfg
export_presets.cfg

# Auto-generated from CSV source files.
*.translation

# ---- Godot .NET / Mono (only if the project ever switches to C#) ----
.mono/
data_*/
mono_crash.*.json
/bin/
/obj/
*.sln.DotSettings.user

# ---- Steamworks SDK ----
# The Steamworks SDK is NOT redistributable. It must never be committed, not
# even to a private repository. Download it per-machine from
# partner.steamgames.com. It is only needed to UPLOAD a build, never to
# develop or run the game -- see docs/steam-integration.md section 3.3.
/steam_sdk/
/addons/godotsteam/sdk/
steam_api*.dll
steam_api*.so
steam_api*.dylib
libsteam_api*

# ...but the GodotSteam plugin bundles Valve's *redistributable* libraries
# inside itself, and its .gdextension file lists them as dependencies. Those
# are a different thing from the SDK above: redistributables are meant to ship
# with a game, and GodotSteam distributes them publicly in its own release zip.
#
# Without these two exceptions the rules above commit 24 of the plugin's 31
# files and silently drop the 7 it depends on, so a fresh clone gets a plugin
# that cannot load -- worse than either committing it or ignoring it outright.
# See docs/decisions.md D58.
!/addons/godotsteam/**/steam_api*.dll
!/addons/godotsteam/**/libsteam_api.*

# Development-only: Valve's guidance is to keep this out of a shipped build,
# and a file that is never committed cannot be shipped by accident. Every
# checkout makes its own; the App ID is in docs/steam-integration.md 3.1.
steam_appid.txt

# ---- Build output ----
/build/
/builds/
/export/
*.pck
*.exe
*.zip
*.dmg
*.apk
*.aab

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
.directory
*~
*.swp
.vscode/
.idea/

# ---- Logs ----
*.log
logs/
